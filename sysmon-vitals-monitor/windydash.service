[Unit]
Description=WindyDash Telemetry Daemon & Web Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/nirjhar/Python Codes/Einstein/WindyDash/sysmon-vitals-monitor
ExecStart="/home/nirjhar/Python Codes/Einstein/einsteinenv/bin/python" sysmon.py
Restart=on-failure
RestartSec=3

# Environment
Environment=SYSMON_HOST=0.0.0.0
Environment=SYSMON_PORT=8765
Environment=SYSMON_INTERVAL=1.0

# Clean shutdown handling
KillSignal=SIGTERM
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=multi-user.target