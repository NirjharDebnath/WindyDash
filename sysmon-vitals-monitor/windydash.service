[Unit]
Description=WindyDash Telemetry Daemon & Web Dashboard | Live on http://127.0.0.1:4040 | Requires Authentication
Documentation=file:/home/nirjhar/Python Codes/Einstein/WindyDash/sysmon-vitals-monitor/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/nirjhar/Python Codes/Einstein/WindyDash/sysmon-vitals-monitor
ExecStart="/home/nirjhar/Python Codes/Einstein/einsteinenv/bin/python" sysmon.py
Restart=on-failure
RestartSec=3

# Environment
EnvironmentFile=/home/nirjhar/Python Codes/Einstein/WindyDash/sysmon-vitals-monitor/.env

# Clean shutdown handling
KillSignal=SIGTERM
TimeoutStopSec=15
KillMode=mixed

[Install]
