[Unit]
Description=SysMon Linux telemetry daemon
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/sysmon/sysmon.py
Restart=on-failure
RestartSec=2
User=root
Environment=SYSMON_HOST=0.0.0.0
Environment=SYSMON_PORT=8765
Environment=SYSMON_INTERVAL=1

[Install]
WantedBy=multi-user.target
