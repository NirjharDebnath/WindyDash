# ==============================================================================
# WindyDash Telemetry Daemon Configuration Template (.env.example)
# Copy to .env and adjust as needed: cp .env.example .env
# ==============================================================================

# Server Network Binding
# Use 127.0.0.1 for local machine only, or 0.0.0.0 for LAN access
SYSMON_HOST=127.0.0.1
SYSMON_PORT=4242

# Telemetry Sampling Interval (seconds)
SYSMON_INTERVAL=1.0

# Anti-DDoS Sliding Window Rate Limiter (requests per window)
RATE_LIMIT=25
RATE_WINDOW=5.0

# ------------------------------------------------------------------------------
# Operator Authentication & Security Vault:
# Operators and passcodes are securely hashed (scrypt) and stored in the
# local SQLite vault (windydash.db). On first boot without users, the web UI
# will display the First-Time Setup Wizard.
#
# You can also manage operator accounts directly via CLI:
#   python3 sysmon.py --listusers            # List all operators
#   python3 sysmon.py --adduser <operator>   # Create a new operator
#   python3 sysmon.py --passwd <operator>    # Change operator password
#
# (Optional) Legacy Master Password:
# Uncomment below only if you need a backward-compatible master passphrase:
# DASH_PASSWORD=
